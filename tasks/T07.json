  "hypotheses": [
    {
      "id": "H01",
      "description": "Only the feature file is oversized; all strict consumers accept the producer contract."
    },
    {
      "id": "H02",
      "description": "Two simultaneous local faults: central duplicate permission rows exceed file cap AND the canary strict parser rejects the 21-field producer payload."
    },
    {
      "id": "H03",
      "description": "The east strict sensor rejects 21 fields while canary correctly expects 21."
    },
    {
      "id": "H04",
      "description": "The west non-strict sensor rejects any newer producer schema even without a field-count requirement."
    },
    {
      "id": "H05",
      "description": "No component fails locally; only a noisy monitoring alert reported errors."
    }
  ],
  "actions": [
    {
      "id": "A01",
      "cost": 1,
      "meaning": "Revert the producer record format globally from 21 fields to 20.",
