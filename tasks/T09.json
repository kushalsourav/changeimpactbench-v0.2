  "hypotheses": [
    {
      "id": "H01",
      "description": "Every edge is unavailable from a global DNS-zone mismatch."
    },
    {
      "id": "H02",
      "description": "West resolver is still pinned to the old target while east proxy exceeds its descriptor budget because of retry fan-out."
    },
    {
      "id": "H03",
      "description": "Only east proxy overload is real; the west DNS cache has already expired."
    },
    {
      "id": "H04",
      "description": "West proxy and south proxy are both over their descriptor caps; DNS is healthy."
    },
    {
      "id": "H05",
      "description": "Only the west DNS target is stale; east remains below its connection budget."
    }
